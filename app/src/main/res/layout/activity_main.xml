<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideHcenter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.50"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideHtop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideHbotton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.98"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideVcenter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideVstart"
        android:orientation="vertical"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:layout_constraintGuide_percent="0.05"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideVend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideH1"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="50dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideH2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="120dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideH3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="200dp"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideH4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="270dp"/>




    <!--검색 TextView + EditText + Button 활용-->
    <TextView
        android:id="@+id/tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="검색(EditText + button)"
        app:layout_constraintTop_toBottomOf="@id/guideH1"
        app:layout_constraintStart_toEndOf="@id/guideVstart"
        android:layout_marginStart="5dp"
        android:textAlignment="center"
        />

    <EditText
        android:id="@+id/inputWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="검색 단어 입력"
        app:layout_constraintEnd_toEndOf="@id/guideVcenter"
        app:layout_constraintStart_toEndOf="@+id/guideVstart"
        app:layout_constraintTop_toBottomOf="@+id/tv" />

    <Button
        android:id="@+id/btnReadFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/guideH1"
        app:layout_constraintStart_toEndOf="@id/guideVcenter"
        app:layout_constraintBottom_toTopOf="@id/guideH2"
        app:layout_constraintEnd_toStartOf="@id/guideVend"
        android:text="Read Word File"
        />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/guideVstart"
        app:layout_constraintTop_toTopOf="@id/guideH2"
        app:layout_constraintBottom_toTopOf="@id/guideH3"
        app:layout_constraintEnd_toStartOf="@id/guideVcenter"
        android:text="Add"
        />

    <Button
        android:id="@+id/btnSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/guideVcenter"
        app:layout_constraintTop_toTopOf="@id/guideH2"
        app:layout_constraintBottom_toTopOf="@id/guideH3"
        app:layout_constraintEnd_toStartOf="@id/guideVend"
        android:text="Search"
        />

<!--
    &lt;!&ndash;검색 SearchView 활용&ndash;&gt;
    <TextView
        android:id="@+id/tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="검색(SearchView)"
        app:layout_constraintTop_toBottomOf="@id/guideH3"
        app:layout_constraintStart_toEndOf="@id/guideVstart"
        android:layout_marginStart="5dp"
        android:textAlignment="center"
        />

    <SearchView
        android:id="@+id/svSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tv2"
        app:layout_constraintStart_toEndOf="@+id/guideVstart"
        app:layout_constraintEnd_toEndOf="@+id/guideVend"
        android:iconifiedByDefault="false"
        android:queryHint="검색어를 입력하세요."
        />
    -->

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideVstart"
        app:layout_constraintEnd_toEndOf="@+id/guideVend"
        />







</androidx.constraintlayout.widget.ConstraintLayout>